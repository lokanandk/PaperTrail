# Copy to .env and fill in, or just export these in your shell.
# Nothing here is required — PaperTrail runs without any of it.

# ── PubMed ───────────────────────────────────────────────────────────────────
# NCBI asks for an email with every request. An API key is optional and raises
# the rate limit from 3 to 10 requests/second.
NCBI_EMAIL=you@example.com
# NCBI_API_KEY=

# ── LLM gateway (optional) ───────────────────────────────────────────────────
# Used only to turn plain-English descriptions into predictions.yaml. Without
# it PaperTrail falls back to its rule-based parser.
#
# Any OpenAI-compatible endpoint works. If you already have a gateway
# configured under a different variable name, PaperTrail finds it on its own —
# run `python llm_gateway.py` to see what it picked up.
# PAPERTRAIL_LLM_BASE_URL=https://your-gateway.example.com
# PAPERTRAIL_LLM_API_KEY=
# PAPERTRAIL_LLM_MODEL=

# Force a specific behaviour instead of auto-detection:
#   rules     never call an LLM
#   llamacpp  use a local GGUF file via PAPERTRAIL_GGUF_PATH
# PAPERTRAIL_LLM_BACKEND=
# PAPERTRAIL_GGUF_PATH=/path/to/model.gguf

# ── Runtime ──────────────────────────────────────────────────────────────────
# Where the shared PubMed record cache lives.
# LITREV_CACHE=./shared_cache

# Pipeline runs are serialised on purpose: the stage modules share process-wide
# state and PubMed rate-limits per IP. Only raise this if you have an NCBI API
# key and understand the consequences.
# PAPERTRAIL_MAX_CONCURRENT_RUNS=1
